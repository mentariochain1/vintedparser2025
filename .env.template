# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# Webhook Configuration
WEBHOOK_DOMAIN=https://your-domain.com
WEBHOOK_PATH=/telegram
WEBHOOK_SECRET=your_webhook_secret_here

# Database Configuration
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/vinted_bot

# Redis Configuration
REDIS_URL=redis://localhost:6379/1

# YooKassa Payment Configuration
# Get these from https://yookassa.ru/my/company
YOOKASSA_SHOP_ID=your_actual_shop_id_from_yookassa
YOOKASSA_SECRET_KEY=your_actual_secret_key_from_yookassa

# Subscription Settings
DEFAULT_TRIAL_DAYS=7
REFERRAL_BONUS_DAYS=3
REFERRAL_SECRET=your_referral_secret_here
SECRET_KEY=your_app_secret_key_here

# API Settings
VINTED_RATE_LIMIT=30
MAX_CONCURRENT_REQUESTS=10

# Environment
ENVIRONMENT=development
DEBUG=false

# Logging
LOG_LEVEL=INFO